# Copy this file to .env and fill it in. Never commit .env.

# --- Claude (sorts each school message) -----------------------------------
ANTHROPIC_API_KEY=
# HUSHBELL_MODEL=claude-opus-5-5
# HUSHBELL_EFFORT=low

# --- Your family (helps sorting and form filling) -------------------------
HUSHBELL_CHILDREN=Maya
HUSHBELL_PARENT_NAME=Ana Lopez
HUSHBELL_SCHOOLS=Lincoln Elementary
# For "open directions to school" and the "time to leave" alarm on urgent pickups:
HUSHBELL_SCHOOL_ADDRESS=
HUSHBELL_TRAVEL_MINUTES=30
# A co-parent Hushbell can text in an emergency (only after you say yes):
HUSHBELL_PARTNER_NAME=
HUSHBELL_PARTNER_PHONE=
# WhatsApp and Gmail also carry personal messages, so Hushbell only reads the
# ones that mention one of these words (your school, your parent group's name).
HUSHBELL_KEYWORDS=Lincoln Elementary,3rd grade parents,PTA

# --- The phone (Android, USB debugging on) ---------------------------------
# HUSHBELL_ADB=adb
# HUSHBELL_ADB_SERIAL=
# Add more school apps: package=Label:school   (or :mixed for apps with personal messages too)
# HUSHBELL_APPS=com.parentsquare.psapp=ParentSquare:school

# How Hushbell acts after your OK: "mobilerun" (default) or "dry-run" (only logs)
# HUSHBELL_PHONE_BACKEND=mobilerun
# HUSHBELL_MOBILERUN_CMD=mobilerun
# The phone agent uses whatever `mobilerun configure` saved, unless you set these:
# HUSHBELL_MOBILERUN_PROVIDER=Anthropic
# HUSHBELL_MOBILERUN_MODEL=

# --- Calls through Do Not Disturb (Twilio) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, like +14155550100
TWILIO_FROM_NUMBER=
# The parent's mobile number, like +14155550123
HUSHBELL_PARENT_PHONE=
# An https address Twilio can reach. Leave empty if you run `ngrok http 8000`: Hushbell finds it.
HUSHBELL_PUBLIC_URL=

# --- The Hushbell page -----------------------------------------------------
# Leave empty to have Hushbell create one (see `hushbell token`).
# HUSHBELL_ACCESS_TOKEN=
# HUSHBELL_PORT=8000
# HUSHBELL_DIGEST_TIME=18:00
# HUSHBELL_DEMO=1
